{
  "schemaVersion": 1,
  "id": "loaderbridge_fixture",
  "version": "1.0.0",
  "name": "LoaderBridge Main Fixture",
  "environment": "*",
  "jars": [
    {"file": "META-INF/jars/loaderbridge-nested-child.jar"}
  ],
  "mixins": [
    {
      "config": "loaderbridge.fixture.mixins.json",
      "environment": "server"
    }
  ],
  "entrypoints": {
    "preLaunch": [
      "dev.loaderbridge.fixture.PreLaunchFixture"
    ],
    "main": [
      "dev.loaderbridge.fixture.MainFixture"
    ],
    "loaderbridge:fixture_api": [
      "dev.loaderbridge.fixture.FixtureApiProvider"
    ],
    "loaderbridge:constructor": [
      "dev.loaderbridge.fixture.FixtureApiProvider::<init>"
    ],
    "loaderbridge:kotlin": [
      {"adapter": "kotlin", "value": "dev.loaderbridge.fixture.KotlinEntrypointShapes$ClassEntrypoint"},
      {"adapter": "kotlin", "value": "dev.loaderbridge.fixture.KotlinEntrypointShapes$ObjectClass"},
      {"adapter": "kotlin", "value": "dev.loaderbridge.fixture.KotlinEntrypointShapes$ObjectFunction::init"},
      {"adapter": "kotlin", "value": "dev.loaderbridge.fixture.KotlinEntrypointShapes$ObjectProperty::initializer"},
      {"adapter": "kotlin", "value": "dev.loaderbridge.fixture.KotlinEntrypointShapes$CompanionClass$Companion"},
      {"adapter": "kotlin", "value": "dev.loaderbridge.fixture.KotlinEntrypointShapes$CompanionFunction$Companion::init"},
      {"adapter": "kotlin", "value": "dev.loaderbridge.fixture.KotlinEntrypointShapes$CompanionProperty$Companion::initializer"},
      {"adapter": "kotlin", "value": "dev.loaderbridge.fixture.KotlinEntrypointShapes$TopLevel::init"}
    ],
    "server": [
      "dev.loaderbridge.fixture.ServerFixture"
    ],
    "client": [
      "dev.loaderbridge.fixture.ClientFixture"
    ]
  },
  "depends": {
    "minecraft": "=1.21.1",
    "java": ">=21",
    "fabricloader": ">=0.16.0"
  }
}
